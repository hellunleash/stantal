{
  "name": "stantal",
  "version": "0.3.0",
  "description": "Tells you whether a model will behave differently after you upgrade a package, before you take the upgrade.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testkit": {
      "types": "./dist/testkit.d.ts",
      "import": "./dist/testkit.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "author": "hellunleash (https://github.com/hellunleash)",
  "homepage": "https://github.com/hellunleash/stantal#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hellunleash/stantal.git"
  },
  "bugs": {
    "url": "https://github.com/hellunleash/stantal/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "llm",
    "agent",
    "tool-calling",
    "breaking-changes",
    "semver",
    "upgrade",
    "api-contract",
    "static-analysis"
  ],
  "bin": {
    "stantal": "./dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "acorn": "^8.18.0",
    "pacote": "^21.5.1",
    "resolve.exports": "^2.0.3",
    "semver": "^7.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/semver": "^7.8.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
